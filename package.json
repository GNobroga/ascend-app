{
  "name": "Projects",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter @apps/api --filter @apps/web dev",
    "api:dev": "pnpm --filter @apps/api start:dev",
    "api:debug": "pnpm --filter @apps/api start:debug",
    "api:start": "pnpm --filter @apps/api start",
    "api:build": "pnpm --filter @apps/api build",
    "api:prod": "pnpm --filter @apps/api start:prod",
    "api:test": "pnpm --filter @apps/api test",
    "api:test:e2e": "pnpm --filter @apps/api test:e2e",
    "api:lint": "pnpm --filter @apps/api lint",
    "api:migration:generate": "pnpm --filter @apps/api migration:generate",
    "api:migration:run": "pnpm --filter @apps/api migration:run",
    "api:migration:revert": "pnpm --filter @apps/api migration:revert",
    "api:storage:setup": "pnpm --filter @apps/api storage:setup",
    "web:dev": "pnpm --filter @apps/web dev",
    "web:build": "pnpm --filter @apps/web build",
    "web:preview": "pnpm --filter @apps/web preview",
    "web:lint": "pnpm --filter @apps/web lint",
    "web:test": "pnpm --filter @apps/web test",
    "web:test:e2e": "pnpm --filter @apps/web test:e2e",
    "storybook:dev": "pnpm --filter @apps/storybook dev",
    "storybook:build": "pnpm --filter @apps/storybook build",
    "infra:up": "docker compose --env-file apps/api/.env up -d --wait && pnpm api:storage:setup",
    "infra:down": "docker compose --env-file apps/api/.env down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.31.0"
}
